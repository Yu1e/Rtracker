<?xml version="1.0" encoding="utf-8"?>
<!-- Главный экран для электронных чернил: белое, чёрное, крупно, без рисованных книг и движения.
     Макет раскладывается по ширине 360 dp и масштабируется под экран от 6 до 12 дюймов. -->
<com.readingtracker.ui.FitScaleLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fit"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- сейчас читаю -->
        <LinearLayout
            android:id="@+id/bookTile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ei_tile"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="сейчас читаю"
                android:textColor="#000000"
                android:textSize="16dp" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="#000000"
                android:textSize="28dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#000000"
                android:textSize="18dp" />

            <TextView
                android:id="@+id/tvBookTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#000000"
                android:textSize="18dp" />
        </LinearLayout>

        <!-- читать и таймер -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.readingtracker.ui.home.ReadButtonView
                android:id="@+id/btnRead"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnTimer"
                android:layout_width="116dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@drawable/ei_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="20dp" />
        </LinearLayout>

        <!-- сегодня и дни подряд -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ei_tile"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="сегодня за книгой"
                    android:textColor="#000000"
                    android:textSize="16dp" />

                <com.readingtracker.ui.home.GoalRingView
                    android:id="@+id/ring"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvRingCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="#000000"
                    android:textSize="15dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/ei_tile"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="дней подряд"
                    android:textColor="#000000"
                    android:textSize="16dp" />

                <TextView
                    android:id="@+id/tvStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginTop="6dp"
                    android:textColor="#000000"
                    android:textSize="56dp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvStreakCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textColor="#000000"
                    android:textSize="15dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- неделя -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/ei_tile"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="минут чтения по дням"
                android:textColor="#000000"
                android:textSize="16dp" />

            <com.readingtracker.ui.home.WeekBarsView
                android:id="@+id/weekBars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- книг за месяц -->
        <TextView
            android:id="@+id/tvMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#000000"
            android:textSize="20dp" />
    </LinearLayout>
</com.readingtracker.ui.FitScaleLayout>
