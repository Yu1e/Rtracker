<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ReadingTracker" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">#5C6BC0</item>
        <item name="colorPrimaryVariant">#3949AB</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">#26A69A</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.ReadingTracker.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">#5C6BC0</item>
        <item name="colorSecondary">#26A69A</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="SettingsSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>
