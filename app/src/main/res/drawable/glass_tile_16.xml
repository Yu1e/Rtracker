<?xml version="1.0" encoding="utf-8"?>
<!-- Матовое стекло: блик по кромке сверху слева, заливка светлее к верху -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="315" android:startColor="@color/gl_edge_hi"
                android:centerColor="@color/gl_edge_mid" android:endColor="@color/gl_edge_lo" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient android:angle="270" android:startColor="@color/gl_fill_top" android:endColor="@color/gl_fill_bottom" />
        </shape>
    </item>
</layer-list>
